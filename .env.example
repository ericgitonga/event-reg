# Turso (libSQL) — get from `vercel env pull .env.local`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Which event this deployment currently serves — set exactly one. ACTIVE_EVENT_ID is checked
# first if both are set.
ACTIVE_EVENT_ID=
ACTIVE_EVENT_SLUG=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` on scheduled
# invocations of /api/cron/* (see vercel.json) — any other value/absence is rejected.
CRON_SECRET=
